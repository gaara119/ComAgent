# Copy to .env. Keep real credentials out of Git and screenshots.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
# Request total budget spans NLU, intent, SQL and bounded repairs; each call stays <=3 attempts.
LLM_REQUEST_MAX_ATTEMPTS=12
LLM_MAX_TOKENS=2048
LLM_THINKING=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_password
DB_NAME=chinook
DB_READER_USER=qa_reader
DB_READER_PASSWORD=replace_with_different_local_password
CHINOOK_PORT=55432
# Preferred SQL names; DB_URL and STATEMENT_TIMEOUT_MS remain compatible.
CHINOOK_DB_URL=postgresql://qa_reader:replace_with_different_local_password@127.0.0.1:55432/chinook
AW_DB_URL=
AW_CATALOG_PATH=data/catalog/adventureworks.yaml
AW_SCHEMA_INDEX_PATH=data/indexes/schema-aw-d3-v2
SQL_STATEMENT_TIMEOUT_MS=5000
DB_URL=postgresql://qa_reader:replace_with_different_local_password@127.0.0.1:55432/chinook
STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=200
SQL_REPAIR_ATTEMPTS=2
CATALOG_PATH=data/catalog/chinook.yaml
API_HOST=127.0.0.1
API_PORT=8000
RAG_HANDLER=qa_agent.rag.service:run_doc_qa
RAG_MANIFEST_PATH=data/docs/manifest.csv
RAG_INDEX_PATH=data/indexes/docs-d2-final-v4.3
BGE_MODEL_PATH=data/models/bge-m3
RAG_TOP_K=8
RAG_CANDIDATE_K=20
RAG_RRF_K=60
RAG_CHUNK_CHARS=500
RAG_CHUNK_OVERLAP=80
RAPIDOCR_MODEL_PATH=data/models/rapidocr
RAG_EMBEDDING_MAX_LENGTH=512
RAG_EMBEDDING_BATCH_SIZE=2
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_QUANTIZATION=int8
RAG_ANSWER_MODE=llm
NLU_ENABLED=true
VALUE_INDEX_PATH=data/indexes/values-oct12-approved
NLU_FUZZY_THRESHOLD=0.82
NLU_FUZZY_MARGIN=0.08
NLU_VECTOR_THRESHOLD=0.82
NLU_VECTOR_MARGIN=0.08
