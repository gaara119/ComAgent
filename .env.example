# Copy to .env. Keep real credentials out of Git and screenshots.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_MAX_TOKENS=2048
LLM_THINKING=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_password
DB_NAME=chinook
DB_READER_USER=qa_reader
DB_READER_PASSWORD=replace_with_different_local_password
CHINOOK_PORT=55432
# Preferred SQL names; DB_URL and STATEMENT_TIMEOUT_MS remain compatible.
CHINOOK_DB_URL=postgresql://qa_reader:replace_with_different_local_password@127.0.0.1:55432/chinook
AW_DB_URL=
SQL_STATEMENT_TIMEOUT_MS=5000
DB_URL=postgresql://qa_reader:replace_with_different_local_password@127.0.0.1:55432/chinook
STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=200
SQL_REPAIR_ATTEMPTS=2
CATALOG_PATH=data/catalog/chinook.yaml
API_HOST=127.0.0.1
API_PORT=8000
RAG_HANDLER=qa_agent.rag.service:run_doc_qa
RAG_MANIFEST_PATH=data/docs/manifest.csv
RAG_INDEX_PATH=data/processed/rag/ohr
BGE_MODEL_PATH=data/models/bge-m3
RAG_TOP_K=5
RAG_EMBEDDING_MAX_LENGTH=512
RAG_EMBEDDING_BATCH_SIZE=2
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_QUANTIZATION=int8
RAG_ANSWER_MODE=llm
