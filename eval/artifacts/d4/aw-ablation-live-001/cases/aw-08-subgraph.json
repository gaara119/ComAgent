    "rewritten_question": null,
    "sql": "SELECT pc.\"name\" AS category_name, COUNT(p.\"productid\") AS product_count FROM \"production\".\"product\" AS p JOIN \"production\".\"productsubcategory\" AS psc ON p.\"productsubcategoryid\" = psc.\"productsubcategoryid\" JOIN \"production\".\"productcategory\" AS pc ON psc.\"productcategoryid\" = pc.\"productcategoryid\" GROUP BY pc.\"name\" ORDER BY product_count DESC, category_name ASC LIMIT 200",
