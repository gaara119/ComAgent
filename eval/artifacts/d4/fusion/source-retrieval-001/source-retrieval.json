          "doc_title": "Chinook 业务指标口径手册 项目自编",
          "page": null,
          "section_path": [
            "已核对的 SQL 示例",
            "平均每张发票金额"
          ],
          "text": "平均每张发票金额\nSELECT ROUND(AVG(total), 2) AS average_invoice_amount\nFROM public.invoice\nWHERE invoice_date >= DATE '2024-01-01'\n  AND invoice_date < DATE '2025-01-01';",
