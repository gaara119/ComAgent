{
  "id": "oct12-join-14",
  "schema": "public",
  "sql": "SELECT m.media_type_id, m.name, COUNT(t.track_id) AS track_count FROM public.media_type AS m LEFT JOIN public.track AS t ON t.media_type_id = m.media_type_id GROUP BY m.media_type_id, m.name ORDER BY m.media_type_id ASC LIMIT 200",
