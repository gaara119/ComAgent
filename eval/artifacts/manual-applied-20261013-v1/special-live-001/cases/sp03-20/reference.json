  "gold_sql": "SELECT ar.artist_id, SUM(il.unit_price * il.quantity) AS revenue FROM public.invoice_line il JOIN public.invoice i ON il.invoice_id = i.invoice_id JOIN public.track t ON il.track_id = t.track_id JOIN public.album al ON t.album_id = al.album_id JOIN public.artist ar ON al.artist_id = ar.artist_id WHERE i.invoice_date >= DATE '2023-01-01' AND i.invoice_date < DATE '2024-01-01' GROUP BY ar.artist_id ORDER BY revenue DESC, ar.artist_id ASC LIMIT 10;",
