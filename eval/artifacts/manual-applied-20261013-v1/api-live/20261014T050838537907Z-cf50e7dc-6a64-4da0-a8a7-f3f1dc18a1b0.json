    "rewritten_question": null,
    "sql": "SELECT pc.name AS category_name, COUNT(p.productid) AS product_count FROM \"production\".\"product\" AS p JOIN \"production\".\"productsubcategory\" AS ps ON p.productsubcategoryid = ps.productsubcategoryid JOIN \"production\".\"productcategory\" AS pc ON ps.productcategoryid = pc.productcategoryid WHERE p.productsubcategoryid IS NOT NULL GROUP BY pc.name ORDER BY product_count DESC, pc.name ASC LIMIT 200",
