          "sql": "SELECT t.name AS territory_name, SUM(soh.subtotal) AS subtotal_total FROM sales.salesorderheader AS soh JOIN sales.salesterritory AS t ON t.territoryid = soh.territoryid WHERE soh.orderdate >= CAST('2024-01-01' AS DATE) AND soh.orderdate < CAST('2025-01-01' AS DATE) AND soh.territoryid IS NOT NULL GROUP BY t.name ORDER BY subtotal_total DESC, territory_name ASC LIMIT 200",
          "db_id": "adventureworks"
        },
        "output_summary": {
          "row_count": 10,
          "columns": [
            "territory_name",
            "subtotal_total"
          ],
          "truncated": false
        },
