{
  "id": "aw-21",
  "sql": "SELECT d.name AS department_name, COUNT(DISTINCT e.businessentityid) AS employee_count FROM humanresources.employee AS e JOIN humanresources.employeedepartmenthistory AS h ON e.businessentityid = h.businessentityid JOIN humanresources.department AS d ON h.departmentid = d.departmentid WHERE e.currentflag = TRUE AND h.enddate IS NULL GROUP BY d.departmentid, d.name ORDER BY employee_count DESC, d.name ASC LIMIT 200",
