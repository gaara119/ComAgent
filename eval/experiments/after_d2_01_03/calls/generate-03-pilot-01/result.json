{
  "cases": [
    {
      "id": "sp03-01",
      "family_id": "special-fam-03-standard-l0-2020-sales-null",
      "task": "03",
      "category": "L0",
      "input": "Chinook 里2020年全年的发票销售额是多少？如果那一年没有发票记录，请直接说没有可用记录，不要用0代替。",
      "scope": {
        "route": "sql",
        "db_id": "chinook",
        "doc_ids": []
      },
      "history": [],
      "expected_behavior": "execute",
      "allowed_interpretations": [
        "按发票销售额 SUM(invoice.total)，期间为 invoice_date 在 [2020-01-01, 2021-01-01) 的发票；无记录时 SUM 为 NULL，回答没有可用销售记录"
      ],
      "expected_bindings": [
        {
          "column": "invoice.invoice_date",
          "operator": ">=",
          "value": "2020-01-01"
        },
        {
          "column": "invoice.invoice_date",
          "operator": "<",
          "value": "2021-01-01"
        }
      ],
      "missing_conditions": [],
      "business_basis": [
        {
          "source": "confirmed_business_rules.metrics[sales_revenue]",
          "rule": "销售额发票粒度用 SUM(invoice.total)；空 SUM 返回 NULL，不能静默替换为 0"
        },
        {
          "source": "confirmed_business_rules.general.period",
          "rule": "期间左闭右开；用户已明确2020年，无需追问；2020年无数据是精确无匹配边界"
        }
      ],
      "reference_intent": {
        "metric": "sales_revenue",
        "time_scope": {
          "year": 2020,
          "range": "[2020-01-01, 2021-01-01)"
        },
        "object": "all invoices"
      },
      "gold_sql": "SELECT SUM(total) AS revenue FROM public.invoice WHERE invoice_date >= DATE '2020-01-01' AND invoice_date < DATE '2021-01-01';",
      "case_style": "standard",
      "secondary_tags": [
        "year_boundary",
        "null_on_empty",
        "no_zero_substitution"
      ],
      "controller": null
    },
    {
