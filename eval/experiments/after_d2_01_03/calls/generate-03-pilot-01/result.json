      ],
      "controller": null
    },
    {
      "id": "sp03-03",
      "family_id": "special-fam-05-standard-l0-year-over-year-revenue",
      "task": "03",
      "category": "L0",
      "input": "2024年巴西的销售额同比2023年增长了多少？",
      "scope": {
        "route": "sql",
        "db_id": "chinook",
        "doc_ids": []
      },
      "history": [],
      "expected_behavior": "execute",
      "allowed_interpretations": [
        "同比：当前完整期间为2024全年 [2024-01-01, 2025-01-01)，基期由同比类型推导为2023全年 [2023-01-01, 2024-01-01)；销售额用 SUM(invoice.total)；地区按客户所在地 customer.country='Brazil'"
      ],
      "expected_bindings": [
        {
          "column": "invoice.invoice_date",
          "operator": ">=",
          "value": "2023-01-01"
        },
        {
          "column": "invoice.invoice_date",
          "operator": "<",
          "value": "2025-01-01"
        },
        {
          "column": "customer.country",
          "operator": "=",
          "value": "Brazil"
        }
      ],
      "missing_conditions": [],
      "business_basis": [
        {
          "source": "total_plan_semantic_gate §3.6.4 clarify_rules.yaml growth.derivable",
          "rule": "同比在 current + comparison.type 齐全时可由规则唯一推导基期，非比较类缺条件才降级"
        },
        {
          "source": "confirmed_business_rules.metrics[sales_revenue]",
          "rule": "销售额发票粒度 SUM(invoice.total)，JOIN 明细后不能重复累加发票总额"
        },
        {
          "source": "approved_aliases a-cf1b483ec6900d1a / a-48667df2696e251c",
          "rule": "巴西 -> Brazil，approved 别名唯一绑定"
        }
      ],
      "reference_intent": {
        "metric": "sales_revenue",
        "time_scope": {
          "current": {
            "year": 2024,
            "range": "[2024-01-01, 2025-01-01)"
          },
          "base": {
            "year": 2023,
            "range": "[2023-01-01, 2024-01-01)"
          },
          "comparison": "year_over_year"
        },
        "region_scope": {
          "column": "customer.country",
          "value": "Brazil"
        }
      },
      "gold_sql": "SELECT (SUM(CASE WHEN invoice_date >= DATE '2024-01-01' AND invoice_date < DATE '2025-01-01' THEN total END) - SUM(CASE WHEN invoice_date >= DATE '2023-01-01' AND invoice_date < DATE '2024-01-01' THEN total END)) / NULLIF(SUM(CASE WHEN invoice_date >= DATE '2023-01-01' AND invoice_date < DATE '2024-01-01' THEN total END), 0) AS yoy_growth_rate FROM public.invoice i JOIN public.customer c ON i.customer_id = c.customer_id WHERE c.country = 'Brazil' AND invoice_date >= DATE '2023-01-01' AND invoice_date < DATE '2025-01-01';",
      "case_style": "standard",
      "secondary_tags": [
        "year_over_year",
        "derived_base_period",
        "comparison_l0"
      ],
      "controller": null
    },
    {
      "id": "sp03-04",
      "family_id": "special-fam-06-ranking-top10-tracks-technical-default",
      "task": "03",
      "category": "L1",
      "input": "2023年按销售额排名最高的曲目，给我Top10。",
      "scope": {
        "route": "sql",
        "db_id": "chinook",
        "doc_ids": []
      },
      "history": [],
      "expected_behavior": "execute_with_assumption",
      "allowed_interpretations": [
        "用户已明确指标（销售额）、排名对象（曲目）和期间（2023年），数量未定，使用总计划 ranking.defaults.top_n=10",
        "指标确认是销售额，曲目粒度按明细 SUM(invoice_line.unit_price * invoice_line.quantity)",
        "可切换为购买数量（SUM(invoice_line.quantity)）或歌单收录数（COUNT(playlist_track.playlist_id)），切换需声明假设"
      ],
      "expected_bindings": [
        {
          "column": "invoice.invoice_date",
          "operator": ">=",
          "value": "2023-01-01"
        },
        {
          "column": "invoice.invoice_date",
          "operator": "<",
          "value": "2024-01-01"
        },
        {
          "column": "invoice_line.track_id",
          "operator": "GROUP BY",
          "value": "track_id"
        }
      ],
      "missing_conditions": [
        "top_n"
      ],
      "business_basis": [
        {
          "source": "total_plan_semantic_gate §3.6.4 clarify_rules.yaml ranking.defaults.top_n",
          "rule": "排名metric/object明确而数量未定时，Top10来自总计划ranking.defaults.top_n=10；属于已登记技术默认"
        },
        {
          "source": "confirmed_business_rules.metrics[sales_revenue].alternative",
          "rule": "曲目/艺术家金额用 SUM(invoice_line.unit_price * invoice_line.quantity)，按 invoice_date 过滤，避免 JOIN 后重复 SUM(invoice.total)"
        },
        {
          "source": "confirmed_business_rules.metrics[sales_revenue].tie_breaker",
          "rule": "并列排序使用 track_id 升序"
        }
      ],
      "reference_intent": {
        "metric": "track_sales_revenue",
        "rank_object": "track",
        "time_scope": {
          "year": 2023,
          "range": "[2023-01-01, 2024-01-01)"
        },
        "top_n": 10
      },
      "gold_sql": "SELECT track_id, SUM(unit_price * quantity) AS track_revenue FROM public.invoice_line WHERE invoice_id IN (SELECT invoice_id FROM public.invoice WHERE invoice_date >= DATE '2023-01-01' AND invoice_date < DATE '2024-01-01') GROUP BY track_id ORDER BY track_revenue DESC, track_id ASC LIMIT 10;",
      "case_style": "top_n_technical_default",
      "secondary_tags": [
        "ranking",
        "top10_default",
        "track_level_amount"
      ],
      "controller": null
    },
    {
      "id": "sp03-05",
      "family_id": "special-fam-07-popular-2007-jazz-tracks-purchased-quantity",
      "task": "03",
      "category": "L1",
      "input": "2007年最受欢迎的10首爵士曲目是哪些？",
      "scope": {
        "route": "sql",
        "db_id": "chinook",
        "doc_ids": []
      },
      "history": [],
      "expected_behavior": "execute_with_assumption",
      "allowed_interpretations": [
        "最受欢迎按登记默认口径购买数量 SUM(invoice_line.quantity)，期间明确为2007年，对象曲目，数量明确10",
        "可切换为按销售额 SUM(unit_price * quantity) 或按被收录歌单数 COUNT(playlist_track.playlist_id)，切换需声明假设",
        "爵士 -> genre.name = 'Jazz'（approved 别名）"
      ],
      "expected_bindings": [
        {
          "column": "invoice.invoice_date",
          "operator": ">=",
          "value": "2007-01-01"
        },
        {
          "column": "invoice.invoice_date",
          "operator": "<",
          "value": "2008-01-01"
        },
        {
          "column": "genre.name",
          "operator": "=",
          "value": "Jazz"
        }
      ],
      "missing_conditions": [],
      "business_basis": [
        {
          "source": "total_plan_semantic_gate §3.6.4 ambiguities.popularity.default",
          "rule": "热门曲目有登记默认 by_quantity，对应 SUM(invoice_line.quantity)；属于L1默认口径"
        },
        {
          "source": "confirmed_business_rules.metrics[popular_tracks]",
          "rule": "曲目对象最受欢迎默认购买数量；并列按 track_id 升序"
        },
        {
          "source": "approved_aliases a-ae481372f2653475 / a-f3ab57aac4760fac",
          "rule": "爵士/爵士乐 -> Jazz；approved 别名唯一绑定"
        }
      ],
      "reference_intent": {
        "metric": "purchased_quantity",
        "rank_object": "track",
        "time_scope": {
          "year": 2007,
          "range": "[2007-01-01, 2008-01-01)"
        },
        "genre": "Jazz",
        "top_n": 10
      },
      "gold_sql": "SELECT t.track_id, SUM(il.quantity) AS purchased_quantity FROM public.invoice_line il JOIN public.invoice i ON i.invoice_id = il.invoice_id JOIN public.track t ON t.track_id = il.track_id JOIN public.genre g ON g.genre_id = t.genre_id WHERE i.invoice_date >= DATE '2007-01-01' AND i.invoice_date < DATE '2008-01-01' AND g.name = 'Jazz' GROUP BY t.track_id ORDER BY purchased_quantity DESC, t.track_id ASC LIMIT 10;",
      "case_style": "default_switchable",
      "secondary_tags": [
        "popularity_default",
        "purchased_quantity",
        "genre_scope",
        "year_scope"
      ],
      "controller": null
    }
  ],
  "notes": []
}