+def explicit_customer_attribute_top(question: str, catalog) -> bool:
+    """An explicit attribute sort is a lookup, not an unknown sales metric.
+
+    Only proven Chinook customer name/ID ordering and an explicit N qualify.
+    Business aggregate/rate requests keep their normal semantic requirements.
+    """
+    if catalog.database.casefold() != 'chinook':
+        return False
+    if any(word in question for word in ('销售额', '金额', '消费', '购买', '买', '复购', '热门', '受欢迎',
+                                        '发票', '账单', '同比', '环比', '增长', '占比', '比例', '平均',
+                                        '数量', '总数', '分组', '汇总', '员工', '艺术家', '曲目')):
+        return False
+    count=re.search(r'前\s*(\d+)\s*(?:位|个|名)?\s*客户',question)
+    ordering=re.search(r'(?:按|依|根据)\s*(?:客户)?(?P<field>姓氏|名字|编号)\s*(?:升序|降序)',question)
+    if not count or not ordering or not 1<=int(count.group(1))<=5000:
+        return False
+    field={'姓氏':'last_name','名字':'first_name','编号':'customer_id'}[ordering.group('field')]
+    table=next((table for table in catalog.tables if table.name=='customer' and table.schema=='public'),None)
+    return bool(table and field in {column.name for column in table.columns})
+
