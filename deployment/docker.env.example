# Copy to .env.docker and edit locally. Never commit your real key.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
RAG_ANSWER_MODE=llm
COMAGENT_UI_PORT=18501
# Existing PostgreSQL on the Windows/macOS host: use host.docker.internal.
# Use read-only users. Empty means database questions are not configured.
CHINOOK_DB_URL=
AW_DB_URL=
# Optional: provide your own valid Fernet key instead of the persistent local key.
# COMAGENT_CREDENTIAL_KEY=
